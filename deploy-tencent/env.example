# Dify 腾讯云部署环境变量配置
# 复制此文件为 .env 并修改相应配置
# cp env.example .env

# ============================================
# 必须修改的配置
# ============================================

# 安全密钥 - 请使用 openssl rand -base64 42 生成
SECRET_KEY=sk-your-secret-key-here

# 访问地址配置 - 根据你的域名或IP修改
# 如果使用域名: https://your-domain.com
# 如果使用IP: http://your-server-ip
CONSOLE_API_URL=http://your-server-ip
CONSOLE_WEB_URL=http://your-server-ip
SERVICE_API_URL=http://your-server-ip
APP_API_URL=http://your-server-ip
APP_WEB_URL=http://your-server-ip
FILES_URL=http://your-server-ip

# ============================================
# 数据库配置 (可选修改)
# ============================================
DB_TYPE=postgresql
DB_USERNAME=postgres
DB_PASSWORD=difyai123456
DB_HOST=db
DB_PORT=5432
DB_DATABASE=dify

# ============================================
# Redis 配置 (可选修改)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=difyai123456
REDIS_DB=0
CELERY_BROKER_URL=redis://:difyai123456@redis:6379/1

# ============================================
# 存储配置
# ============================================
STORAGE_TYPE=opendal
OPENDAL_SCHEME=fs
OPENDAL_FS_ROOT=storage

# 如果使用腾讯云 COS 存储，取消注释并配置以下内容:
# STORAGE_TYPE=tencent-cos
# TENCENT_COS_BUCKET_NAME=your-bucket-name
# TENCENT_COS_SECRET_KEY=your-secret-key
# TENCENT_COS_SECRET_ID=your-secret-id
# TENCENT_COS_REGION=ap-guangzhou
# TENCENT_COS_SCHEME=https

# ============================================
# 向量数据库配置
# ============================================
VECTOR_STORE=weaviate
WEAVIATE_ENDPOINT=http://weaviate:8080
WEAVIATE_API_KEY=WVF5YThaHlkYwhGUSmCRgsX3tD5ngdN8pkih

# ============================================
# 插件配置 (一般不需要修改)
# ============================================
PLUGIN_DAEMON_URL=http://plugin_daemon:5002
PLUGIN_DAEMON_KEY=lYkiYYT6owG+71oLerGzA7GXCgOT++6ovaezWAjpCjf+Sjc3ZtU+qUEi
PLUGIN_DIFY_INNER_API_KEY=QaHbTe77CtuXmsfyhR7+vRjI/+XbV1AaFy691iy+kGDv2Jvy0/eAh8Y1

# ============================================
# 沙箱配置 (一般不需要修改)
# ============================================
CODE_EXECUTION_ENDPOINT=http://sandbox:8194
CODE_EXECUTION_API_KEY=dify-sandbox
SANDBOX_API_KEY=dify-sandbox

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
